# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
HISTORY_LIMIT=10

# Neon MCP - BD (opcional - dejar en blanco para deshabilitar)
NEON_API_KEY=
NEON_PROJECT_ID=

# Demo MCP server local (../03_mcp_server). Déjala VACÍA: se busca sola en <repo>/03_mcp_server,
# así que no importa si tu terminal escribe rutas con / o con \ ni si es Git Bash.
# Pon "off" para desactivarlo. Nota: retrieve_documents (Qdrant) vive en 03_mcp_server, así que
# desactivarlo también deshabilita la búsqueda en la base de conocimiento (ver 03_mcp_server/.env.example).
DEMO_MCP_SERVER_PATH=

# Groq (InputGuardrail — Capas 7 y 8: Llama Prompt Guard 2 y gpt-oss-safeguard-20b)
GROQ_API_KEY=gsk_...
GROQ_PROMPT_GUARD_MODEL=meta-llama/Llama-Prompt-Guard-2-86M
GROQ_LLAMA_GUARD_MODEL=openai/gpt-oss-safeguard-20b
GROQ_TIMEOUT_SECONDS=3

# InputGuardrail — Capa 4 (timeout anti-ReDoS por regla, en segundos)
CUSTOM_REGEX_TIMEOUT_SECONDS=1

# LangSmith (trazas de LangChain — opcional, dejar LANGSMITH_TRACING=false para deshabilitar)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=default
# Hooks: presupuesto de tokens por conversación (TokenBudgetMiddleware)
TOKEN_BUDGET=8000
